source 'https://rubygems.org'

# Same Jekyll + plugin versions GitHub Pages used in "legacy" mode,
# so the Actions build produces the same site as before.
gem 'github-pages', group: :jekyll_plugins

group :jekyll_plugins do
  gem 'jekyll-paginate'
  gem 'jekyll-sitemap'
end

gem 'webrick' # needed for `jekyll serve` on Ruby 3+
